{
  "name": "kumo-farm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kumo Farm: a cozy farm on a floating cloud island. A KumoPlay game.",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "SIM_REPORT=1 vitest run src/sim",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
